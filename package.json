{
  "name": "workers-start",
  "version": "0.6.0",
  "description": "The parts every TanStack Start app on Cloudflare Workers ends up writing: Markdown for agents on the same URL, a head helper that stops share cards leaking between pages, lazy Workers bindings, and a check that no local secret ships in the build.",
  "license": "MIT",
  "author": "Ryan Ghods",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanio/workers-start.git"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "tanstack-start",
    "tanstack",
    "vite",
    "seo",
    "markdown",
    "llms"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./entry": {
      "types": "./dist/entry.d.ts",
      "import": "./dist/entry.js",
      "default": "./dist/entry.js"
    },
    "./head": {
      "types": "./dist/head.d.ts",
      "import": "./dist/head.js",
      "default": "./dist/head.js"
    },
    "./workers": {
      "types": "./dist/workers.d.ts",
      "import": "./dist/workers.js",
      "default": "./dist/workers.js"
    },
    "./scripts": {
      "types": "./dist/scripts.d.ts",
      "import": "./dist/scripts.js",
      "default": "./dist/scripts.js"
    },
    "./check-bundle": {
      "types": "./dist/check-bundle.d.ts",
      "import": "./dist/check-bundle.js",
      "default": "./dist/check-bundle.js"
    },
    "./seo": {
      "types": "./dist/seo.d.ts",
      "import": "./dist/seo.js",
      "default": "./dist/seo.js"
    },
    "./accept": {
      "types": "./dist/accept.d.ts",
      "import": "./dist/accept.js",
      "default": "./dist/accept.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "workers-start-check-bundle": "dist/check-bundle-cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/check-bundle-cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "npm run build && vitest run",
    "check": "npm run lint && npm run typecheck && npm run build && vitest run",
    "prepack": "npm run build",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}

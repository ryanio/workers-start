#!/bin/bash
# Pre-commit: Biome checks the staged files, then vitest runs the tests the
# staged change can reach through its imports. A staged vitest config or
# package-lock.json can break any test, so either runs the full suite.
# Typecheck, the build and the full gate stay with `npm run check` and CI.

REPO=$(basename "$(git rev-parse --show-toplevel)")
LOG_FILE="/tmp/${REPO}-pre-commit-output.txt"
exec > >(tee "$LOG_FILE") 2>&1

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0

fail() {
  echo ""
  echo ">>> Pre-commit $1 failed. Full output saved to $LOG_FILE"
  exit 1
}

npx biome check --staged --no-errors-on-unmatched || fail "biome"

if echo "$STAGED" | grep -qE '^(vitest\.config\.[cm]?[jt]s|package-lock\.json)$'; then
  npx vitest run || fail "tests"
  exit 0
fi

SOURCES=()
while IFS= read -r f; do SOURCES+=("$f"); done < <(echo "$STAGED" | grep -E '\.(ts|tsx|js|mjs|cjs)$')
[ ${#SOURCES[@]} -eq 0 ] && exit 0

npx vitest related --run --passWithNoTests "${SOURCES[@]}" || fail "tests"
